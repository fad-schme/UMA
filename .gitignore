# Ignore build artifacts, caches, local environments, secrets, and local data.
# Nothing else. A broad ignore rule here is how `docs/mcp/*` was written and
# then lost without ever appearing in `git status` — keep this list narrow so
# `git status` stays trustworthy.

# Python bytecode and build output
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/

# Virtual environments
.venv/
.venv*
venv/
env/
ENV/
.Python
# Test, lint, and type-check caches
.pytest_cache/
.pytest_tmp/
tmp_pytest/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets and local overrides
.env
*.local.yaml

# Local UMA state: databases, vector indexes, run output
.uma/
*.db
*.sqlite
*.sqlite3
locomo/runs/
.gold_runs/

# Coding-agent instructions belong in the parent working folder, never here.
CLAUDE.md
AGENTS.md
.codex/
.claude/settings.local.json
.claude/skills/dev/

# Internal working notes; the rest of docs/ is published documentation.
docs/readiness/

# Editor and OS metadata
.vscode/
.DS_Store
._*
__MACOSX/
Thumbs.db
Desktop.ini

# Logs
*.log
resources/
scripts